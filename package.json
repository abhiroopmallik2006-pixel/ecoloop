{
  "name": "ecoloop-ai",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ecoloop/web",
    "build": "npm run build --workspace=@ecoloop/web",
    "start": "npm run start --workspace=@ecoloop/web",
    "typecheck": "npm run typecheck --workspace=@ecoloop/web",
    "test": "node --test tests/*.test.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test -g 'automated WCAG'"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0"
  }
}
